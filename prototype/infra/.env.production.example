# 羲和生产环境配置示例
# 复制到服务器 /data/xihe/config/.env.production 后再填写真实值。
# 注意：真实 .env.production 不要提交到 Git。

# PostgreSQL 容器初始化配置
TZ=Asia/Shanghai
PGTZ=Asia/Shanghai
POSTGRES_DB=xihe
POSTGRES_USER=xihe_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# API 运行配置
API_HOST=0.0.0.0
API_PORT=8787
DATABASE_URL=postgres://xihe_app:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@postgres:5432/xihe
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=http://127.0.0.1,https://xihe.example.com
BACKUP_DIR=/data/xihe/backups/json

# 页面内提醒默认开启；企业微信等外部推送后续再启用
DEFAULT_NOTIFICATION_CHANNELS=in_app
# Optional: enable WeChat Mini Program login.
# WECHAT_MINIPROGRAM_APPID=replace_with_appid
# WECHAT_MINIPROGRAM_SECRET=replace_with_secret
# WECOM_BOT_WEBHOOK=

# 定时提醒脚本使用
XIHE_API_BASE=http://api:8787
REMINDER_EMAIL=admin@example.com

# 首次试运行管理员账号初始化
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_10_CHARS
ADMIN_DISPLAY_NAME=羲和管理员
ADMIN_ROLE=super_admin
# ADMIN_USER_ID=

# 备份脚本使用
XIHE_BACKUP_DIR=/data/xihe/backups/postgres
XIHE_BACKUP_RETENTION_DAYS=30
